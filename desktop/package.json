{
  "name": "@beyon/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "bun run build:main && bun run build:preload && concurrently --kill-others \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "vite build --watch --config vite.renderer.config.ts",
    "dev:electron": "wait-on dist/renderer/index.html dist/main/main.js && electron .",
    "build": "bun run build:renderer && bun run build:main && bun run build:preload",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json"
  },
  "dependencies": {
    "electron": "^43.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
