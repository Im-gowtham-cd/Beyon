# ─── BEYON ENVIRONMENT: FLOCI (LOCAL AWS EMULATION) ───
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 Buckets
BEYON_S3_BUCKET_DOCUMENTS=beyon-documents
BEYON_S3_BUCKET_RESUMES=beyon-resumes
BEYON_S3_BUCKET_CERTIFICATES=beyon-certificates
BEYON_S3_BUCKET_EVIDENCE=beyon-evidence

# Messaging & Events
BEYON_SQS_QUEUE_RECOMMENDATIONS=beyon-recommendation-queue
BEYON_SNS_TOPIC_NOTIFICATIONS=beyon-notifications
BEYON_EVENTBRIDGE_BUS=beyon.events

# Databases
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/beyon
DATABASE_USERNAME=root
DATABASE_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/beyon
REDIS_URL=redis://localhost:6379

# Service URLs
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=dev
AI_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
