# ─── BEYON ENVIRONMENT: PRODUCTION AWS ───
# AWS_ENDPOINT_URL left blank so AWS SDK automatically resolves real regional endpoints
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Buckets
BEYON_S3_BUCKET_DOCUMENTS=beyon-documents-prod
BEYON_S3_BUCKET_RESUMES=beyon-resumes-prod
BEYON_S3_BUCKET_CERTIFICATES=beyon-certificates-prod
BEYON_S3_BUCKET_EVIDENCE=beyon-evidence-prod

# Messaging & Events
BEYON_SQS_QUEUE_RECOMMENDATIONS=beyon-recommendation-queue-prod
BEYON_SNS_TOPIC_NOTIFICATIONS=beyon-notifications-prod
BEYON_EVENTBRIDGE_BUS=beyon.events

# Databases
DATABASE_URL=jdbc:mysql://dolt-host.internal:3306/beyon
DATABASE_USERNAME=root
DATABASE_PASSWORD=
MONGODB_URI=mongodb://mongo-host.internal:27017/beyon
REDIS_URL=redis://elasticache-redis.internal:6379

# Service URLs
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=prod
AI_SERVICE_URL=http://ai-service.internal:8000
CORS_ALLOWED_ORIGINS=https://beyon.app,https://app.beyon.io
