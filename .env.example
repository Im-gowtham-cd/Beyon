# ===========================================
# Beyon — Environment Variables
# ===========================================
# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Supabase)
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# MongoDB Atlas
MONGODB_URI=

# Upstash Redis
REDIS_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AI Service
AI_SERVICE_URL=http://localhost:8000

# JWT
JWT_SECRET=

# Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
