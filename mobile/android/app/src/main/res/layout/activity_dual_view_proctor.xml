<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- 1. FULLSCREEN LIVE CAMERA PREVIEW (Edge-to-edge, crystal clear) -->
    <TextureView
        android:id="@+id/textureViewCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. TRANSPARENT CAMERA RETICLE & LIVE TELEMETRY OVERLAY -->
    <FrameLayout
        android:id="@+id/overlayReticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="230dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <!-- Status Badges in Viewfinder -->
        <TextView
            android:id="@+id/tvLiveIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#B30F172A"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="● LIVE CAMERA VIEW"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTelemetryWatermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="#B30F172A"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="AI PROCTOR READY"
            android:textColor="#FED601"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPulseCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="#B30F172A"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="PULSE #0"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAudioLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="#B30F172A"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="AUDIO: QUIET"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 3. TOP BRANDING HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#F8FFFFFF"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="5dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:background="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEYON"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="DUALVIEW PROCTOR"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Camera Switch Quick Toggle in Header -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCameraHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="REAR"
            android:textColor="#0F172A"
            android:textSize="10sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_camera_switch_dark"
            app:iconSize="14dp"
            app:iconTint="#0F172A"
            app:iconPadding="4dp"
            app:iconGravity="textStart"
            app:backgroundTint="#FED601"
            app:cornerRadius="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <!-- Kiosk Secured Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EFF6FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="#16A34A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="KIOSK ACTIVE"
                android:textColor="#1E40AF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. REAL-TIME INCIDENT BANNER (Appears when violations detected) -->
    <LinearLayout
        android:id="@+id/bannerWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="60dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="#E6DC2626"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWarningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WARNING: Additional person detected in camera view"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. BOTTOM FLOATING CARD: PAIRING CONTROLS (Compact, leaves 75%+ screen free) -->
    <LinearLayout
        android:id="@+id/cardPairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F8FFFFFF"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Environmental Camera Angle"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:text="Position phone at 45 degree angle facing candidate and workspace."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- 1-Tap QR Code Scanner Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan Desktop Assessment QR Code"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:icon="@drawable/ic_qr_scan"
            app:iconSize="18dp"
            app:iconTint="#0F172A"
            app:iconPadding="8dp"
            app:iconGravity="textStart"
            app:backgroundTint="#FED601"
            app:cornerRadius="8dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp" />

        <!-- Camera Switch Option Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Switch to Front Camera"
            android:textColor="#253CAC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:icon="@drawable/ic_camera_switch"
            app:iconSize="16dp"
            app:iconTint="#253CAC"
            app:iconPadding="8dp"
            app:iconGravity="textStart"
            app:backgroundTint="#EEF2FF"
            app:strokeColor="#C7D2FE"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Manual token entry row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etPairingToken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_option_default"
                android:fontFamily="monospace"
                android:hint="Or enter token"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Connect"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#253CAC"
                app:cornerRadius="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- Server Gateway Config Footer -->
        <LinearLayout
            android:id="@+id/btnConfigServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvServerHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Gateway: 10.1.36.24:8085 (Tap to change)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. BOTTOM FLOATING CARD: ACTIVE STREAMING CONTROLS (Visible After Connection) -->
    <LinearLayout
        android:id="@+id/cardStreaming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F8FFFFFF"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STREAMING TO DESKTOP"
                    android:textColor="#166534"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCandidateId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live environmental camera linked."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Switch camera while streaming button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchCameraStreaming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Flip Camera"
                android:textColor="#253CAC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_camera_switch"
                app:iconSize="14dp"
                app:iconTint="#253CAC"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:backgroundTint="#EEF2FF"
                app:strokeColor="#C7D2FE"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnect"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#FEE2E2"
                app:strokeColor="#FCA5A5"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>